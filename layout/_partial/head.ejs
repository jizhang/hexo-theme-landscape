<head>
  <meta charset="utf-8">
  <%- partial('google-analytics') %>
  <%
  var title = page.title;

  if (is_archive()){
    title = __('archive_a');

    if (is_month()){
      title += ': ' + page.year + '/' + page.month;
    } else if (is_year()){
      title += ': ' + page.year;
    }
  } else if (is_category()){
    title = __('category') + ': ' + page.category;
  } else if (is_tag()){
    title = __('tag') + ': ' + page.tag;
  }
  %>
  <title><% if (title){ %><%= title %> | <% } %><%= config.title %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

  <% if (page.alt_zh) { %>
    <link rel="alternate" hreflang="en" href="<%= page.permalink %>">
    <link rel="alternate" hreflang="zh" href="<%- full_url_for('zh/' + page.alt_zh) %>">
    <link rel="alternate" hreflang="x-default" href="<%= page.permalink %>">
  <% } else if (page.alt_en) { %>
    <link rel="alternate" hreflang="en" href="<%- full_url_for('../' + page.alt_en) %>">
    <link rel="alternate" hreflang="zh" href="<%= page.permalink %>">
    <link rel="alternate" hreflang="x-default" href="<%- full_url_for('../' + page.alt_en) %>">
  <% } %>

  <%- open_graph({twitter_id: theme.twitter, fb_admins: theme.fb_admins, fb_app_id: theme.fb_app_id}) %>
  <% if (config.feed) { %>
    <%- feed_tag() %>
  <% } else if (theme.rss) { %>
    <%- feed_tag(theme.rss) %>
  <% } %>
  <% if (theme.favicon){ %>
    <%- favicon_tag(theme.favicon) %>
  <% } %>
  <% if (config.highlight.enable){ %>
    <%- css('https://cdn.jsdelivr.net/npm/typeface-source-code-pro@0.0.71/index.min.css') %>
  <% } %>
  <%- css('css/style') %>
  <% if (theme.fancybox){ %>
    <%- css('fancybox/jquery.fancybox.min.css') %>
  <% } %>
  <%- css('https://cdn.jsdelivr.net/npm/fork-awesome@1.2.0/css/fork-awesome.min.css') %>
</head>
